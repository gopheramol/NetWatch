# Copy to .env and adjust before running `docker compose up`.

# Set this to how your BROWSER will reach the backend — e.g. your home
# server's LAN IP or hostname (not "backend", that's only resolvable
# container-to-container). Baked into the frontend at build time.
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:8080

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
