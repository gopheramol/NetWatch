FROM golang:1.25-alpine AS build
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/netwatch-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 -S netwatch && adduser -u 10001 -S netwatch -G netwatch

WORKDIR /app
COPY --from=build /out/netwatch-server ./netwatch-server
COPY configs ./configs

RUN mkdir -p /app/data && chown -R netwatch:netwatch /app
USER netwatch

VOLUME ["/app/data"]
ENV PORT=8080 GOMEMLIMIT=768MiB
EXPOSE 8080

ENTRYPOINT ["./netwatch-server"]
CMD ["--config", "/app/configs"]
